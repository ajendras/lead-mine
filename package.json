{
  "name": "lead-mine",
  "version": "0.1.0",
  "description": "CLI to scrape and enrich targeted business leads from Google Search, Maps, Yelp, YellowPages, Crunchbase and directories. Self-hosted, transparent, and polite.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lead-mine": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "leads",
    "scraper",
    "google-maps",
    "google-search",
    "yelp",
    "yellowpages",
    "crunchbase",
    "business-intelligence",
    "sales",
    "cli",
    "playwright"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "csv-writer": "^1.6.0",
    "playwright": "^1.44.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "@types/node": "^20.14.2",
    "tsx": "^4.11.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
